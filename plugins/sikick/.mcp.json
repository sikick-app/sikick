{
  "mcpServers": {
    "sikick": {
      "type": "http",
      "url": "${user_config.mcp_url}",
      "headersHelper": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/mcp-headers.mjs\""
    },
    "flow": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/mcp/server.mjs"
      ],
      "env": {
        "SIKICK_URL": "${SIKICK_URL:-}",
        "SIKICK_PLUGIN_URL": "${user_config.sikick_url}",
        "SIKICK_HOME": "${SIKICK_HOME:-}"
      }
    }
  }
}
